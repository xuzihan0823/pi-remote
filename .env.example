# Address the relay HTTP/WS server binds to. Keep 127.0.0.1 so only Caddy on this
# host can reach it; never expose the relay port directly.
RELAY_HOST=127.0.0.1

# Port for the relay HTTP/WS server. Defaults to 8789.
RELAY_PORT=8789

# Shared secret required by every HTTP/WS client. Minimum 32 characters.
# Generate with: openssl rand -hex 32
RELAY_TOKEN=

# WebSocket URL of the relay agent endpoint used by the Mac agent. Defaults to
# ws://$RELAY_HOST:$RELAY_PORT/ws/agent. Must not embed a token.
RELAY_URL=

# Token the Mac agent presents to the relay. Falls back to RELAY_TOKEN when unset.
AGENT_TOKEN=

# Stable device id the Mac agent announces to the relay. Defaults to pi-mac-agent.
AGENT_DEVICE_ID=pi-mac-agent

# Path or command name of the pi CLI used for RPC subprocesses.
PI_BIN=pi

# Absolute directory the agent uses as its session workspace root. Defaults to
# the current user's Desktop. Requested cwds are confined to this directory.
PI_WORKSPACE_ROOT=

# Maximum number of concurrent pi sessions the agent may start.
MAX_SESSIONS=16
