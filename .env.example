# Address the relay HTTP/WS server binds to. Keep 127.0.0.1 so only Caddy on this
# host can reach it; never expose the relay port directly.
RELAY_HOST=127.0.0.1

# Port for the relay HTTP/WS server. Defaults to 8789.
RELAY_PORT=8789

# Shared secret required by every HTTP/WS client. Minimum 32 characters.
# Generate with: openssl rand -hex 32
RELAY_TOKEN=

# WebSocket URL of the relay agent endpoint used by the Mac agent. Defaults to
# ws://$RELAY_HOST:$RELAY_PORT/ws/agent. Must not embed a token.
RELAY_URL=

# Token the Mac agent presents to the relay. Falls back to RELAY_TOKEN when unset.
AGENT_TOKEN=

# Stable device id the Mac agent announces to the relay. Defaults to pi-mac-agent.
AGENT_DEVICE_ID=pi-mac-agent

# The Mac agent manages Pi Desktop sessions only. PI_RUNTIME, PI_BIN and
# OMP_HISTORY_ROOTS no longer enable CLI discovery or execution in this entry point.
# Start Pi Desktop separately with PI_DESKTOP_MCP_CONTROL=1; its local token
# stays on the Mac and must not be copied into this file or sent to the relay.

# Default project selection location. New sessions select an existing Desktop
# project; all persistence and execution are owned by Pi Desktop.
PI_WORKSPACE_ROOT=

# Retained for relay / legacy component compatibility, not Desktop execution.
MAX_SESSIONS=16
