+const repoRoot = join(here, "../../..");
+register(pathToFileURL(join(here, "helpers/ts-import-hooks.mjs")));
+
+const dataModule = (source) => `data:text/javascript,${encodeURIComponent(source)}`;
+const fallbacks = {
+  "@pi-desktop/shared": pathToFileURL(join(repoRoot, "packages/shared/src/index.ts")).href,
+  "@pi-desktop/agent-runtime": dataModule(`
+export function expandSlashInvocation() { throw new Error("agent-runtime is unavailable"); }
+export function visionFromModelConfig() { throw new Error("agent-runtime is unavailable"); }
+`),
+  "@pi-desktop/host-runtime": dataModule(`
+export function executionFromResponse() { throw new Error("host-runtime is unavailable"); }
+export function resolveSessionMessageInput() { throw new Error("host-runtime is unavailable"); }
+`),
+  typebox: dataModule(`
+const inert = new Proxy(function () {}, {
+  get: () => inert,
+  apply: () => inert,
+  construct: () => inert,
+});
+export default new Proxy({}, { get: () => inert });
