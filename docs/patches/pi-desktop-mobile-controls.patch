+};
+register(dataModule(`
+const fallbacks = ${JSON.stringify(fallbacks)};
+export async function resolve(specifier, context, next) {
+  try {
+    return await next(specifier, context);
+  } catch (error) {
+    if (error?.code === "ERR_MODULE_NOT_FOUND" && Object.prototype.hasOwnProperty.call(fallbacks, specifier)) {
+      return { url: fallbacks[specifier], shortCircuit: true };
+    }
+    throw error;
+  }
+}
+`));
+
+const { registerAgentIpc } = await import(
+  pathToFileURL(join(here, "../electron/main/ipc/agent-ipc.ts")).href
+);
+const { IPC, ErrorCodes } = await import("@pi-desktop/shared");
+
+const askFor = (sessionId, requestId) => ({
+  sessionId,
+  requestId,
+  toolCallId: `tool-${requestId}`,
+  questions: [{ question: "Which branch should I use?", options: [] }],
+});
+
+const permissionFor = (sessionId, requestId) => ({
+  sessionId,
+  requestId,
+  toolCallId: `tool-${requestId}`,
+  toolName: "shell",
+});
+
+function createPendingHandler({ sessions = [], pending = { asks: [], permissions: [] } } = {}) {
+  const handlers = new Map();
+  const hostCalls = [];
+  const bridgeCalls = [];
+  registerAgentIpc({
+    registrar: { handle: (channel, fn) => handlers.set(channel, fn) },
+    getHost: () => ({
+      call: async (method) => {
+        hostCalls.push(method);
+        if (method === "session.list") return { sessions };
+        throw new Error(`unexpected host call: ${method}`);
+      },
+    }),
+    getSidecar: () => null,
+    getAgentHostBridge: () => ({
+      pendingInteractiveRequests: async (sessionId) => {
+        bridgeCalls.push(sessionId);
+        return pending;
+      },
+    }),
+    logger: { app() {} },
+  });
+  const handle = handlers.get(IPC.invoke.pendingInteractive);
+  assert.ok(handle, "pendingInteractive handler must be registered");
+  return { handle, hostCalls, bridgeCalls };
+}
+
+test("pending interactive keeps only the requested local session's cards", async () => {
+  const pending = {
+    asks: [askFor("session-a", "ask-a"), askFor("session-b", "ask-b")],
+    permissions: [
+      permissionFor("session-a", "perm-a"),
+      permissionFor("session-b", "perm-b"),
+    ],
+  };
+  const { handle, hostCalls, bridgeCalls } = createPendingHandler({
+    sessions: [
+      { id: "session-a", source: "desktop" },
+      { id: "session-b", source: "desktop" },
+    ],
+    pending,
+  });
+
+  const restored = await handle({ sessionId: " session-a " });
+
+  assert.deepEqual(restored, {
+    asks: [askFor("session-a", "ask-a")],
+    permissions: [permissionFor("session-a", "perm-a")],
+  });
+  assert.deepEqual(hostCalls, ["session.list"]);
+  assert.deepEqual(bridgeCalls, ["session-a"]);
+});
+
+test("unknown, remote, and non-desktop sessions fail closed", async () => {
+  const { handle, hostCalls, bridgeCalls } = createPendingHandler({
+    sessions: [
+      { id: "local-a", source: "desktop" },
+      { id: "remote-a", source: "remote", remoteHostKey: "host-1" },
+      { id: "remote-b", remoteHostKey: "host-2" },
+      { id: "native-row", source: "pi-native" },
+    ],
+    pending: { asks: [askFor("local-a", "ask-a")], permissions: [] },
+  });
+
+  for (const sessionId of ["missing", "remote-a", "remote-b", "native-row"]) {
+    await assert.rejects(
+      () => handle({ sessionId }),
+      (error) => error.errorCode === ErrorCodes.NOT_FOUND,
+      `${sessionId} must not read a pending queue`,
+    );
+  }
+  assert.equal(bridgeCalls.length, 0);
+  assert.equal(hostCalls.length, 4);
+});
+
+test("native sessions keep the empty contract and oversized ids are rejected", async () => {
+  const { handle, hostCalls, bridgeCalls } = createPendingHandler({
+    sessions: [{ id: "local-a", source: "desktop" }],
+  });
+
+  assert.deepEqual(await handle({ sessionId: "native-pi:abc" }), { asks: [], permissions: [] });
+  await assert.rejects(
+    () => handle({ sessionId: "x".repeat(257) }),
+    (error) => error.errorCode === ErrorCodes.INVALID_ARGUMENT,
+  );
+  await assert.rejects(
+    () => handle({ sessionId: "   " }),
+    (error) => error.errorCode === ErrorCodes.INVALID_ARGUMENT,
+  );
+  assert.equal(hostCalls.length, 0);
+  assert.equal(bridgeCalls.length, 0);
+});
