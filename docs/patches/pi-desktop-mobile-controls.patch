@@ -0,0 +1,293 @@
+import assert from "node:assert/strict";
+import * as fs from "node:fs";
+import * as path from "node:path";
+import test from "node:test";
+import ts from "typescript";
+import { ErrorCodes } from "../../../packages/shared/src/errors.ts";
+import { IPC, IPC_WHITELIST } from "../../../packages/shared/src/protocol.ts";
+
+function load(relative, imports) {
+  const file = new URL(relative, import.meta.url);
+  const { outputText } = ts.transpileModule(fs.readFileSync(file, "utf8"), {
+    compilerOptions: { target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.CommonJS },
+    fileName: file.pathname,
+  });
+  const module = { exports: {} };
+  new Function("require", "exports", "module", outputText)((id) => {
+    assert.ok(Object.hasOwn(imports, id), `unexpected IPC dependency: ${id}`);
+    return imports[id];
+  }, module.exports, module);
+  return module.exports;
+}
+
+const shared = {
+  ErrorCodes,
+  IPC,
+  IPC_WHITELIST,
+  modelConfigImportKey: () => null,
+  publicModelConfigCandidate: (candidate) => candidate,
+  draftMatchesExisting: () => false,
+  providerCreateInputFromDraft: (draft) => draft,
+  isModelConfigImportSource: () => false,
+};
+
+const remoteState = { boot: null };
+const { registerSessionIpc } = load("../electron/main/ipc/session-ipc.ts", {
+  electron: { shell: {} },
+  "node:fs": fs,
+  "node:path": path,
+  "@pi-desktop/shared": shared,
+  "../importers": {},
+  "../services/session-collaboration": {},
+  "../services/session-search": {},
+  "../bootstrap/remote-hosts.js": {
+    getActiveRemoteHostsBoot: () => remoteState.boot,
+  },
+});
+
+const providers = [
+  {
+    id: "provider-a",
+    name: "Provider A",
+    enabled: true,
+    models: [{ id: "model-a" }, { id: "model-b" }],
+    defaultModelId: "model-a",
+  },
+  {
+    id: "provider-disabled",
+    name: "Disabled",
+    enabled: false,
+    models: [{ id: "model-d" }],
+  },
+];
+
+function harness({
+  sessions = [
+    {
+      id: "session-1",
+      source: "desktop",
+      mode: "plan",
+      permissionMode: "ask",
+      thinkingLevel: "high",
+      providerId: "provider-a",
+      modelId: "model-a",
+    },
+  ],
+  cachedModels = [],
+  setModel = async () => ({
+    session: {
+      id: "session-1",
+      mode: "plan",
+      permissionMode: "ask",
+      thinkingLevel: "high",
+      providerId: "provider-a",
+      modelId: "model-b",
+    },
+  }),
+} = {}) {
+  remoteState.boot = null;
+  const handlers = new Map();
+  const calls = [];
+  const events = [];
+  registerSessionIpc({
+    registrar: { handle: (channel, handler) => handlers.set(channel, handler) },
+    getHost: () => ({
+      call: async (method, input) => {
+        calls.push({ method, input });
+        if (method === "session.list") return { sessions };
+        if (method === "providers.listModels") return { models: cachedModels };
+        if (method === "session.setModel") return setModel(method, input);
+        throw new Error(`unexpected host call: ${method}`);
+      },
+    }),
+    getSidecar: () => null,
+    dataDir: "/tmp/pi-desktop-session-model-test",
+    activeTurns: new Map(),
+    sessionProjects: new Map(),
+    persistenceOutbox: {},
+    logger: { app: () => undefined },
+    plugins: {
+      broadcastEvent: (channel, payload) => events.push({ channel, payload }),
+    },
+    sessionCapabilityContext: async () => ({ providers, defaults: {} }),
+    enrichSession: (session) => ({ ...session, supportsReasoning: true }),
+    acquireSessionOperation: async () => () => undefined,
+    beginTranscriptRewrite: () => ({ commit() {}, rollback() {} }),
+    forgetTranscriptRewriteHistory: () => undefined,
+    stripWinLongPrefix: (value) => value,
+  });
+  const handle = handlers.get(IPC.invoke.sessionSetModel);
+  assert.equal(typeof handle, "function");
+  return { handle, calls, events };
+}
+
+test("the model-only channel is a registered shared IPC contract", () => {
+  assert.equal(IPC.invoke.sessionSetModel, "pi-desktop/session/setModel");
+  assert.equal(IPC_WHITELIST.has(IPC.invoke.sessionSetModel), true);
+});
+
+test("setModel rejects configs with unknown or missing fields before any write", async () => {
+  const cases = [
+    { providerId: "provider-a", modelId: "model-b", mode: "agent" },
+    { providerId: "provider-a", modelId: "model-b", thinkingLevel: "off" },
+    { providerId: "provider-a" },
+    {},
+  ];
+  for (const config of cases) {
+    const { handle, calls } = harness();
+    await assert.rejects(handle("session-1", config), {
+      errorCode: ErrorCodes.INVALID_ARGUMENT,
+    });
+    assert.deepEqual(calls, []);
+  }
+});
+
+test("setModel bounds the id and the two config strings", async () => {
+  const cases = [
+    "",
+    "   ",
+    "a".repeat(257),
+  ];
+  for (const id of cases) {
+    const { handle, calls } = harness();
+    await assert.rejects(handle(id, { providerId: "provider-a", modelId: "model-b" }), {
+      errorCode: ErrorCodes.INVALID_ARGUMENT,
+    });
+    assert.deepEqual(calls, []);
+  }
+  for (const config of [
+    { providerId: "", modelId: "model-b" },
+    { providerId: "provider-a", modelId: " " },
+    { providerId: "p".repeat(129), modelId: "model-b" },
+    { providerId: "provider-a", modelId: "m".repeat(257) },
+  ]) {
+    const { handle, calls } = harness();
+    await assert.rejects(handle("session-1", config), {
+      errorCode: ErrorCodes.INVALID_ARGUMENT,
+    });
+    assert.deepEqual(calls, []);
+  }
+});
+
+test("setModel rejects native and remote sessions without touching the host", async () => {
+  const native = harness();
+  await assert.rejects(
+    native.handle("native-pi:fixture", { providerId: "provider-a", modelId: "model-b" }),
+    { errorCode: ErrorCodes.INVALID_ARGUMENT },
+  );
+  assert.deepEqual(native.calls, []);
+
+  const remote = harness();
+  remoteState.boot = {
+    sessionSummaries: () => [
+      { id: "remote:host-a:session-1", source: "remote", remoteHostKey: "host-a" },
+    ],
+  };
+  try {
+    await assert.rejects(
+      remote.handle("remote:host-a:session-1", {
+        providerId: "provider-a",
+        modelId: "model-b",
+      }),
+      { errorCode: ErrorCodes.INVALID_ARGUMENT },
+    );
+  } finally {
+    remoteState.boot = null;
+  }
+  assert.deepEqual(remote.calls, []);
+});
+
+test("setModel calls the host RPC and broadcasts the model change", async () => {
+  const { handle, calls, events } = harness();
+  const result = await handle("session-1", {
+    providerId: "provider-a",
+    modelId: "model-b",
+  });
+
+  assert.deepEqual(calls, [
+    { method: "session.list", input: undefined },
+    {
+      method: "session.setModel",
+      input: { id: "session-1", providerId: "provider-a", modelId: "model-b" },
+    },
+  ]);
+  assert.equal(calls.some((call) => call.method === "session.configure"), false);
+  assert.equal(result.session.id, "session-1");
+  assert.equal(result.session.providerId, "provider-a");
+  assert.equal(result.session.modelId, "model-b");
+  assert.equal(result.session.mode, "plan");
+  assert.equal(result.session.permissionMode, "ask");
+  assert.equal(result.session.thinkingLevel, "high");
+  assert.equal(result.session.supportsReasoning, true);
+  assert.deepEqual(events, [
+    {
+      channel: "session:modelChanged",
+      payload: [
+        {
+          sessionId: "session-1",
+          modelKey: "provider-a/model-b",
+          thinkingLevel: "high",
+        },
+      ],
+    },
+  ]);
+});
+
+test("setModel accepts a cached catalog model without a binding", async () => {
+  const { handle, calls, events } = harness({
+    cachedModels: [{ modelId: "model-cached", displayName: "Cached model" }],
+    setModel: async () => ({
+      session: {
+        id: "session-1",
+        mode: "plan",
+        permissionMode: "ask",
+        thinkingLevel: "high",
+        providerId: "provider-a",
+        modelId: "model-cached",
+      },
+    }),
+  });
+  const result = await handle("session-1", {
+    providerId: "provider-a",
+    modelId: "model-cached",
+  });
+
+  assert.deepEqual(calls.map((call) => call.method), [
+    "session.list",
+    "providers.listModels",
+    "session.setModel",
+  ]);
+  assert.deepEqual(calls[1].input, { providerId: "provider-a" });
+  assert.deepEqual(calls[2].input, {
+    id: "session-1",
+    providerId: "provider-a",
+    modelId: "model-cached",
+  });
+  assert.equal(result.session.modelId, "model-cached");
+  assert.equal(events.length, 1);
+});
+
+test("setModel rejects unconfigured providers and unknown models before mutating", async () => {
+  for (const config of [
+    { providerId: "missing-provider", modelId: "model-b" },
+    { providerId: "provider-disabled", modelId: "model-d" },
+    { providerId: "provider-a", modelId: "missing-model" },
+  ]) {
+    const { handle, calls, events } = harness();
+    await assert.rejects(handle("session-1", config), {
+      errorCode: ErrorCodes.INVALID_ARGUMENT,
+    });
+    assert.equal(calls.some((call) => call.method === "session.setModel"), false);
+    assert.deepEqual(events, []);
+  }
+});
+
+test("setModel reports a missing session without mutating", async () => {
+  const { handle, calls, events } = harness({ sessions: [] });
+  await assert.rejects(
+    handle("missing-session", { providerId: "provider-a", modelId: "model-b" }),
+    { errorCode: ErrorCodes.NOT_FOUND },
+  );
+  assert.equal(calls.some((call) => call.method === "session.setModel"), false);
+  assert.deepEqual(events, []);
+});
