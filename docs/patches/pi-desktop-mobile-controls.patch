+/// Require a non-empty, bounded string without rewriting the caller's value.
+fn required_bounded_string(
+    params: &Value,
+    name: &str,
+    max_bytes: usize,
+) -> Result<String, JsonRpcError> {
+    let Some(value) = params.get(name) else {
+        return Err(rpc_err(1002, format!("{name} required"), "INVALID_PARAMS"));
+    };
+    let Some(value) = value.as_str() else {
+        return Err(rpc_err(
+            1002,
+            format!("{name} must be a string"),
+            "INVALID_PARAMS",
+        ));
+    };
+    if value.trim().is_empty() {
+        return Err(rpc_err(
+            1002,
+            format!("{name} must not be empty"),
+            "INVALID_PARAMS",
+        ));
+    }
+    if value.len() > max_bytes {
+        return Err(rpc_err(
+            1002,
+            format!("{name} must not exceed {max_bytes} bytes"),
+            "INVALID_PARAMS",
+        ));
+    }
+    Ok(value.to_string())
+}
